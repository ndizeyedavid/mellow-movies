# Mellow Movies — Environment template
# Copy to .env (root) or backend/.env and fill values.
# Never commit real .env — it is gitignored.

# ------------------------------------------------------------------ PROXY (backend)
# Your laptop's Cloudflare tunnel — top priority when online.
# Get it by running:  scripts/start-home-proxy.ps1  (prints https://xxx.trycloudflare.com)
HOME_TUNNEL_URL=https://xxx-xxxx.trycloudflare.com
# Aliases (any one works): HOME_PROXY_URL, HOME_TUNNEL_PROXY, PRIMARY_PROXY
# HOME_PROXY_URL=
# PRIMARY_PROXY=

# Fallback pool — comma / newline / semicolon separated, order matters after home.
# Example with 3 free Webshares (get at webshare.io):
RESIDENTIAL_PROXY=http://user1:pass1@p1.webshare.io:port, http://user2:pass2@p2.webshare.io:port, http://user3:pass3@p3.webshare.io:port
# Aliases: RESIDENTIAL_PROXY_URL, HTTP_PROXY, HTTPS_PROXY, http_proxy, https_proxy

# Optional: token required to POST /api/admin/home-tunnel (auto-register from your PC).
# If empty, any caller that knows the URL can update it.
# HOME_TUNNEL_TOKEN=some-random-secret

# ------------------------------------------------------------------ REPORTS (backend/api.py: ReportRequest)
# Fine-grained GitHub PAT with issues:write on ndizeyedavid/mellow-movies
GITHUB_REPORT_TOKEN=github_pat_xxx
GITHUB_REPORT_REPO=ndizeyedavid/mellow-movies
GITHUB_REPORT_LABELS=user-report,bug
# ntfy.sh — subscribe on your phone to get pushes
NTFY_TOPIC=mellow-movies-reports
NTFY_SERVER=https://ntfy.sh

# ------------------------------------------------------------------ HOME DOWN NOTIFY — Email via MongoDB + Google SMTP
# Frontend overlay "Home server is napping" (4h countdown, localStorage) +
# POST /api/notify/email (MongoDB, 24h TTL) + POST /api/notify/recovery (SMTP blast)
#
# Dev default: mongodb://localhost:27017/mellow_movies (no auth, local mongo)
# Prod example (Atlas): mongodb+srv://user:pass@cluster.mongodb.net/mellow_movies?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mellow_movies
# Alias: MONGO_URL=

# Google SMTP — for the "We're back!" branded email to all saved addresses.
# How to get a Gmail App Password:
#  1. Enable 2-Step Verification on your Google account
#  2. Go to myaccount.google.com/apppasswords
#  3. Create App Password for "Mail" → copy 16-char code (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Aliases accepted: SMTP_USER=GOOGLE_SMTP_USER=GMAIL_USER, SMTP_PASS=GOOGLE_SMTP_PASS=GMAIL_APP_PASSWORD=GMAIL_PASS
# Optional: custom From header (defaults to SMTP_USER)
# SMTP_FROM=Mellow Movies <noreply@mellowmovies.app>
# SMTP_FROM=noreply@mellowmovies.app

# ------------------------------------------------------------------ FRONTEND (frontend/.env)
# Where the browser finds the backend. Local: http://localhost:8000  Prod: https://mellow-movies.fastapicloud.dev
# VITE_API_BASE=http://localhost:8000
