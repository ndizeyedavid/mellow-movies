# Backend .env.example — copy to backend/.env (or root .env)
# See also root /.env.example for full docs.

HOME_TUNNEL_URL=https://xxx-xxxx.trycloudflare.com
RESIDENTIAL_PROXY=http://user1:pass1@p1.webshare.io:port, http://user2:pass2@p2.webshare.io:port
# HOME_TUNNEL_TOKEN=

GITHUB_REPORT_TOKEN=github_pat_xxx
GITHUB_REPORT_REPO=ndizeyedavid/mellow-movies
GITHUB_REPORT_LABELS=user-report,bug
NTFY_TOPIC=mellow-movies-reports
NTFY_SERVER=https://ntfy.sh

# Home-down notify (overlay 4h + email 24h TTL + SMTP blast)
MONGODB_URI=mongodb://localhost:27017/mellow_movies
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/mellow_movies?retryWrites=true&w=majority

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# SMTP_FROM=noreply@mellowmovies.app
