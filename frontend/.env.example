# Frontend .env.example — copy to frontend/.env
# Local dev (default handles LAN via window.location.hostname, so phones on same Wi-Fi just work):
VITE_API_BASE=http://localhost:8000

# Production — point to your hosted FastAPI:
# VITE_API_BASE=https://mellow-movies.fastapicloud.dev

# Note: Home-down overlay polls GET /health/proxy every 30s and uses:
#  - localStorage keys mm-home-down-start / mm-home-down-dismissed (4h countdown, survives reload)
#  - local Notifications API (push, keep tab open) + POST /api/notify/email (Mongo 24h TTL -> SMTP)
